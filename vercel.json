{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/quote/:slug",
      "destination": "https://ojfezodyjvlzexxqbgak.supabase.co/functions/v1/quote/:slug"
    },
    {
      "source": "/quote/:slug/",
      "destination": "https://ojfezodyjvlzexxqbgak.supabase.co/functions/v1/quote/:slug"
    }
  ],
  "headers": [
    {
      "source": "/quote/:path*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src https: data:; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        },
        {
          "key": "X-Probe-Override",
          "value": "applied"
        }
      ]
    }
  ]
}
